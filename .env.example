# Shopify Storefront API — required for the site to load products & cart
# Copy this file to .env.local and fill in real values.

# Your store's *.myshopify.com domain (no https://), e.g. dygn.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API access token (Shopify admin → Settings → Apps and sales channels
# → Develop apps → your app → API credentials → Storefront API access token)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
